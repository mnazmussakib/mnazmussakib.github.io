---
/**
 * Content comes from src/data/home.json (news + contact sections) —
 * edit there directly, or through the /admin CMS portal.
 */
import home from '../data/home.json';
const { news, contact } = home;
---
<style>
  .news-about { padding: 56px 0; border-bottom: 1px solid var(--border); }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 160px; }
  .news-item {
    display: flex; gap: 16px; padding: 13px 0 13px 12px; border-bottom: 1px solid var(--border); align-items: baseline;
    border-left: 3px solid transparent;
    animation: news-sweep 4.8s ease-in-out infinite;
  }
  .news-item:last-child { border-bottom: none; }
  @keyframes news-sweep {
    0%, 100% { background: transparent; border-left-color: transparent; }
    4%, 14% { background: var(--amber-50); border-left-color: var(--amber-200); }
    18% { background: transparent; border-left-color: transparent; }
  }
  .news-date { font-size: 12px; color: var(--text-tertiary); min-width: 75px; font-family: var(--font-body); }
  .news-text { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
  .news-badge { display: inline-block; font-size: 10px; font-weight: 500; padding: 1px 7px; border-radius: 99px; margin-left: 6px; vertical-align: middle; letter-spacing: 0.03em; }
  .contact-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }
  .contact-link {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 14px; color: var(--amber-600); text-decoration: none;
    width: fit-content; transition: color 0.15s;
  }
  .contact-link:hover { color: var(--teal-600); text-decoration: underline; }
  .contact-icon { width: 18px; height: 18px; flex-shrink: 0; color: var(--amber-200); transition: color 0.15s; }
  .contact-link:hover .contact-icon { color: var(--teal-400); }
  .life-link { font-size: 13px; }
  .life-link a { color: var(--amber-600); text-decoration: underline; }
  @media (max-width: 640px) { .two-col { grid-template-columns: 1fr; } }
</style>

<section class="news-about">
  <div class="two-col">

    <!-- News column -->
    <div>
      <p class="section-eyebrow">News</p>
      <h2 style="margin-bottom:20px;">Recent updates</h2>
      <div>
        {news.map((item, i) => (
          <div class="news-item" style={`animation-delay: ${i * (4800 / news.length)}ms`}>
            <span class="news-date">{item.date}</span>
            <span class="news-text">
              {item.text}
              <span class={`news-badge ${item.badge}`}>{item.label}</span>
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact column -->
    <div>
      <p class="section-eyebrow">Contact</p>
      <h2 style="margin-bottom:16px;">Get in touch</h2>
      <div class="contact-list">
        <a href={`mailto:${contact.email}`} class="contact-link">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 5.5h18v13H3z"/>
            <path d="M3 6l9 7 9-7"/>
          </svg>
          <span>{contact.email}</span>
        </a>
        <a href={contact.linkedin} target="_blank" class="contact-link">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4v15h-4V8zM8.5 8h3.84v2.05h.05c.53-1.01 1.84-2.05 3.79-2.05 4.05 0 4.8 2.67 4.8 6.14V23h-4v-6.9c0-1.65-.03-3.76-2.3-3.76-2.3 0-2.66 1.8-2.66 3.65V23h-4V8z"/>
          </svg>
          <span>LinkedIn</span>
        </a>
        <a href={contact.scholar} target="_blank" class="contact-link">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 3L1 9l4 2.18v6.02L12 21l7-3.8v-6.02L21 9 12 3zm6.8 6L12 12.7 5.2 9 12 5.3 18.8 9zM7 14.1l5 2.72 5-2.72v3.6L12 20.5l-5-2.8v-3.6z"/>
          </svg>
          <span>Google Scholar</span>
        </a>
      </div>
      <p class="life-link">
        See more on my <a href="/life">life page</a> →
      </p>
    </div>

  </div>
</section>
