---
/**
 * Content comes from src/data/home.json (news + contact sections) —
 * edit there directly, or through the /admin CMS portal.
 */
import home from '../data/home.json';
const { news, contact } = home;

const NEWS_PER_PAGE = 5;
const totalPages = Math.max(1, Math.ceil(news.length / NEWS_PER_PAGE));
---
<style>
  .news-about { padding: 56px 0; border-bottom: 1px solid var(--border); }
  .two-col { display: grid; grid-template-columns: 1.6fr 1fr; gap: 200px; }
  .news-item {
    display: flex; gap: 16px; padding: 13px 0 13px 12px; border-bottom: 1px solid var(--border); align-items: center;
    border-left: 3px solid transparent;
    animation: news-sweep 4.8s ease-in-out infinite;
  }
  .news-item:last-child { border-bottom: none; }
  @keyframes news-sweep {
    0%, 100% { background: transparent; border-left-color: transparent; }
    4%, 14% { background: var(--amber-50); border-left-color: var(--amber-200); }
    18% { background: transparent; border-left-color: transparent; }
  }
  .news-date { font-size: 12px; color: var(--text-tertiary); min-width: 75px; font-family: var(--font-body); flex-shrink: 0; }
  .news-text { font-size: 13px; color: var(--text-secondary); line-height: 1.5; flex: 1; }
  .news-badge { display: inline-block; font-size: 10px; font-weight: 500; padding: 1px 7px; border-radius: 99px; letter-spacing: 0.03em; flex-shrink: 0; text-align: center; }
  .news-icon { width: 14px; height: 14px; margin-right: 4px; vertical-align: -2px; color: var(--amber-600); }
  .news-pagination { display: flex; align-items: center; gap: 14px; margin-top: 16px; }
  .news-page-btn {
    font-family: var(--font-body); font-size: 12px; font-weight: 500;
    color: var(--amber-600); background: transparent; border: 1px solid var(--amber-100);
    border-radius: var(--radius-md); padding: 5px 12px; cursor: pointer; transition: all 0.15s;
  }
  .news-page-btn:hover:not(:disabled) { background: var(--amber-50); border-color: var(--amber-200); }
  .news-page-btn:disabled { color: var(--text-tertiary); border-color: var(--border); cursor: default; }
  .news-page-indicator { font-size: 12px; color: var(--text-tertiary); }
  .contact-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }
  .contact-link {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 14px; color: var(--amber-600); text-decoration: none;
    width: fit-content; transition: color 0.15s;
  }
  .contact-link:hover { color: var(--teal-600); text-decoration: underline; }
  .contact-icon { width: 18px; height: 18px; flex-shrink: 0; color: var(--amber-200); transition: color 0.15s; }
  .contact-link:hover .contact-icon { color: var(--teal-400); }
  .life-link { font-size: 13px; }
  .life-link a { color: var(--amber-600); text-decoration: underline; }
  @media (max-width: 640px) { .two-col { grid-template-columns: 1fr; } }
</style>

<section class="news-about">
  <div class="two-col">

    <!-- News column -->
    <div>
      <p class="section-eyebrow">News</p>
      <h2 style="margin-bottom:20px;">Recent updates</h2>
      <div id="news-list">
        {news.map((item, i) => {
          const page = Math.floor(i / NEWS_PER_PAGE);
          const posInPage = i % NEWS_PER_PAGE;
          const delay = posInPage * (4800 / NEWS_PER_PAGE);
          return (
            <div
              class="news-item"
              data-page={page}
              style={`animation-delay: ${delay}ms;${page === 0 ? '' : ' display:none;'}`}
            >
              <span class="news-date">{item.date}</span>
              <span class="news-text">
                {item.text.toLowerCase().includes('award') && (
                  <svg class="news-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 4h10v5a5 5 0 0 1-10 0V4z"/>
                    <path d="M7 5H4a3 3 0 0 0 3 5"/>
                    <path d="M17 5h3a3 3 0 0 1-3 5"/>
                    <path d="M12 14v4M8 21h8"/>
                  </svg>
                )}
                {item.text}
              </span>
              <span class={`news-badge ${item.badge}`}>{item.label}</span>
            </div>
          );
        })}
      </div>
      {totalPages > 1 && (
        <div class="news-pagination">
          <button type="button" id="news-prev" class="news-page-btn" disabled>← Prev</button>
          <span class="news-page-indicator" id="news-page-indicator">Page 1 of {totalPages}</span>
          <button type="button" id="news-next" class="news-page-btn">Next →</button>
        </div>
      )}
    </div>

    <!-- Contact column -->
    <div>
      <p class="section-eyebrow">Contact</p>
      <h2 style="margin-bottom:16px;">Get in touch</h2>
      <div class="contact-list">
        <a href={`mailto:${contact.email}`} class="contact-link">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 5.5h18v13H3z"/>
            <path d="M3 6l9 7 9-7"/>
          </svg>
          <span>{contact.email}</span>
        </a>
        <a href={contact.linkedin} target="_blank" class="contact-link">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4v15h-4V8zM8.5 8h3.84v2.05h.05c.53-1.01 1.84-2.05 3.79-2.05 4.05 0 4.8 2.67 4.8 6.14V23h-4v-6.9c0-1.65-.03-3.76-2.3-3.76-2.3 0-2.66 1.8-2.66 3.65V23h-4V8z"/>
          </svg>
          <span>LinkedIn</span>
        </a>
        <a href={contact.scholar} target="_blank" class="contact-link">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 3L1 9l4 2.18v6.02L12 21l7-3.8v-6.02L21 9 12 3zm6.8 6L12 12.7 5.2 9 12 5.3 18.8 9zM7 14.1l5 2.72 5-2.72v3.6L12 20.5l-5-2.8v-3.6z"/>
          </svg>
          <span>Google Scholar</span>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  const items = Array.from(document.querySelectorAll('#news-list .news-item'));
  const prevBtn = document.getElementById('news-prev');
  const nextBtn = document.getElementById('news-next');
  const indicator = document.getElementById('news-page-indicator');

  if (items.length && prevBtn && nextBtn && indicator) {
    const totalPages = Math.max(...items.map((el) => Number(el.dataset.page))) + 1;
    let currentPage = 0;

    const render = () => {
      items.forEach((el) => {
        el.style.display = Number(el.dataset.page) === currentPage ? '' : 'none';
      });
      indicator.textContent = `Page ${currentPage + 1} of ${totalPages}`;
      prevBtn.disabled = currentPage === 0;
      nextBtn.disabled = currentPage === totalPages - 1;
    };

    prevBtn.addEventListener('click', () => {
      if (currentPage > 0) { currentPage--; render(); }
    });
    nextBtn.addEventListener('click', () => {
      if (currentPage < totalPages - 1) { currentPage++; render(); }
    });
  }
</script>
