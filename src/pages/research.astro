---
/**
 * Layout only — don't edit this file to add projects.
 * Add/edit projects in: src/content/research/*.md (or via the /admin CMS portal)
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const themeBadge = { 'blue-a': 'badge-amber', 'blue-b': 'badge-teal' };

const projectsRaw = await getCollection('research');
const projects = await Promise.all(
  projectsRaw
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({
      entry,
      Content: (await entry.render()).Content,
    }))
);
---
<Base title="Research — Md. Nazmus Sakib" description="Human-AI Interaction research projects">
<style>
  .page-hero {
    padding: 64px 0 48px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 56px;
  }
  .page-hero p { max-width: 560px; font-size: 15px; margin-top: 12px; }

  .project-full {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }
  .project-full:last-child { border-bottom: none; }
  .proj-meta {}
  .proj-num {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--border);
    line-height: 1;
    margin-bottom: 12px;
  }
  .proj-status {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 99px;
    margin-bottom: 12px;
  }
  .status-active { background: var(--teal-50); color: var(--teal-600); border: 1px solid #CDD3F2; }
  .status-complete { background: var(--bg-muted); color: var(--text-tertiary); border: 1px solid var(--border); }
  .proj-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }

  .proj-content h3 { font-size: 1.3rem; margin-bottom: 10px; }
  .proj-content p { font-size: 14px; line-height: 1.8; margin-bottom: 14px; }
  .proj-pubs { margin-top: 20px; }
  .pub-item {
    background: var(--bg-muted);
    border-radius: var(--radius-md);
    padding: 14px 18px;
    margin-bottom: 8px;
  }
  .pub-item p { font-size: 13px; font-weight: 500; color: var(--text-primary); margin-bottom: 4px; }
  .pub-item span { font-size: 12px; color: var(--text-tertiary); }
  .pub-link { font-size: 12px; color: var(--amber-600); margin-left: 12px; }
  .pub-link:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .project-full { grid-template-columns: 1fr; gap: 20px; }
    .proj-num { font-size: 2rem; }
  }
</style>

<div class="container">
  <div class="page-hero">
    <p class="section-eyebrow">Research</p>
    <h1>What I am currently working on</h1>
  </div>

  {projects.map(({ entry, Content }, i) => (
    <div id={entry.slug} class="project-full">
      <div class="proj-meta">
        <div class="proj-num">{String(i + 1).padStart(2, '0')}</div>
        <span class={`proj-status ${entry.data.status === 'active' ? 'status-active' : 'status-complete'}`}>
          {entry.data.status === 'active' ? 'Active' : 'Completed'}
        </span>
        {(entry.data.tagLabel || entry.data.tags.length > 0) && (
          <div class="proj-tags">
            {entry.data.tagLabel && <span class={`tag ${themeBadge[entry.data.theme]}`}>{entry.data.tagLabel}</span>}
            {entry.data.tags.map(t => <span class="tag">{t}</span>)}
          </div>
        )}
      </div>
      <div class="proj-content">
        <h3>{entry.data.title}</h3>
        <Content />
        {entry.data.pubs.length > 0 && (
          <div class="proj-pubs">
            {entry.data.pubs.map(pub => (
              <div class="pub-item">
                <p>{pub.title}</p>
                <span>{pub.venue}</span>
                {pub.pdf && <a href={pub.pdf} class="pub-link">PDF →</a>}
                {pub.code && <a href={pub.code} class="pub-link">Code →</a>}
                {pub.talk && <a href={pub.talk} class="pub-link">Talk →</a>}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  ))}
</div>
</Base>
